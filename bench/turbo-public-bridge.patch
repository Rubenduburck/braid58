+#![allow(dead_code, missing_docs, unreachable_pub)]
+
+use core::slice;
+
+use crate::BITCOIN;
+
+const FAILURE: usize = usize::MAX;
+
+unsafe fn encode<const N: usize, const C: usize>(
+    input: *const u8,
+    output: *mut u8,
+) -> usize {
+    if input.is_null() || output.is_null() {
+        return FAILURE;
+    }
+    let source = unsafe { slice::from_raw_parts(input, N) };
+    let destination = unsafe { slice::from_raw_parts_mut(output, C) };
+    BITCOIN.encode_into(source, destination).unwrap_or(FAILURE)
+}
+
+unsafe fn decode<const OUT_CAP: usize>(
+    input: *const u8,
+    input_len: usize,
+    output: *mut u8,
+) -> usize {
+    if input.is_null() || output.is_null() {
+        return FAILURE;
+    }
+    let source = unsafe { slice::from_raw_parts(input, input_len) };
+    let destination = unsafe { slice::from_raw_parts_mut(output, OUT_CAP) };
+    BITCOIN.decode_into(source, destination).unwrap_or(FAILURE)
+}
+
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn turbo_bench_encode_public_32(
+    input: *const u8,
+    output: *mut u8,
+) -> usize {
+    unsafe { encode::<32, 44>(input, output) }
+}
+
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn turbo_bench_decode_public_32(
+    input: *const u8,
+    input_len: usize,
+    output: *mut u8,
+) -> usize {
+    unsafe { decode::<44>(input, input_len, output) }
+}
+
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn turbo_bench_encode_public_64(
+    input: *const u8,
+    output: *mut u8,
+) -> usize {
+    unsafe { encode::<64, 88>(input, output) }
+}
+
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn turbo_bench_decode_public_64(
+    input: *const u8,
+    input_len: usize,
+    output: *mut u8,
+) -> usize {
+    unsafe { decode::<88>(input, input_len, output) }
+}
